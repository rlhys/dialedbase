# Copy to backend/.env and fill in. Never commit the real .env.

# --- Database (existing) ---
MONGO_URL=mongodb://localhost:27017
DB_NAME=dialedbase
CORS_ORIGINS=http://localhost:3000

# --- Admin auth ---
# Generate a long random secret, e.g. python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_EXPIRE_MINUTES=720
ADMIN_EMAIL=rhysgbp@gmail.com
# Generate offline: python -c "from passlib.context import CryptContext;print(CryptContext(schemes=['bcrypt']).hash('YOUR_PASSWORD'))"
ADMIN_PASSWORD_HASH=

# --- Square ---
SQUARE_ACCESS_TOKEN=
SQUARE_ENVIRONMENT=sandbox
SQUARE_LOCATION_ID=
SQUARE_WEBHOOK_SIGNATURE_KEY=
SQUARE_WEBHOOK_NOTIFICATION_URL=https://your-domain.vercel.app/_/backend/api/webhooks/square
# Catalog subscription plan variation used for monthly recurring billing.
SQUARE_DEFAULT_PLAN_VARIATION_ID=

# --- Reminders (future tier-2 cron) ---
CRON_SECRET=
